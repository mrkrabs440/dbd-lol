# ===========================================================================
# DBD Clone 서버 환경 변수 (.env)
# 이 파일을 복사하여 `.env` 로 이름을 바꾼 뒤 값을 채워 넣으세요.
#   cp .env.example .env
# ===========================================================================

# --- 서버 기본 설정 ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# CORS 허용 오리진 (콤마로 구분). 개발 중에는 * 를 사용해도 됩니다.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# --- MongoDB 연결 문자열 ---
# 로컬 개발용 예시: mongodb://127.0.0.1:27017/dbd_clone
# Atlas 예시: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dbd_clone?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/dbd_clone

# --- JWT 인증 설정 ---
# 운영 환경에서는 반드시 32자 이상의 무작위 문자열로 교체하세요.
JWT_SECRET=please_change_this_to_a_long_random_secret_key_32chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=dbd-clone-server

# --- bcrypt 해싱 라운드 (클수록 안전/느림) ---
BCRYPT_SALT_ROUNDS=12

# --- 매치메이킹 / 게임 규칙 설정 ---
MATCH_SIZE=4
SURVIVORS_PER_MATCH=3
KILLERS_PER_MATCH=1
GENERATORS_PER_MATCH=3
