# ===========================================================================
# DBD Clone 서버 환경 변수 (.env)
# 이 파일을 복사하여 `.env` 로 이름을 바꾼 뒤 값을 채워 넣으세요.
#   cp .env.example .env
# ===========================================================================

# --- 서버 기본 설정 ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# CORS 허용 오리진 (콤마로 구분). 개발 중에는 * 를 사용해도 됩니다.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Supabase 연결 설정 ---
# Supabase 대시보드 → Project Settings → API 에서 확인
# server/supabase/schema.sql 을 SQL Editor 에서 먼저 실행하세요.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi... (service_role 키, 절대 공개 금지)

# --- JWT 인증 설정 ---
# 운영 환경에서는 반드시 32자 이상의 무작위 문자열로 교체하세요.
JWT_SECRET=please_change_this_to_a_long_random_secret_key_32chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=dbd-clone-server

# --- bcrypt 해싱 라운드 (클수록 안전/느림) ---
BCRYPT_SALT_ROUNDS=12

# --- 매치메이킹 / 게임 규칙 설정 ---
MATCH_SIZE=4
SURVIVORS_PER_MATCH=3
KILLERS_PER_MATCH=1
GENERATORS_PER_MATCH=3
